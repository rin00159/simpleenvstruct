{
	"compilerOptions": {
		// ESM-only package: anything that can load it already supports ES2020 syntax (`??`).
		// `lib` is pinned to match, so reaching for a newer runtime API is a type error.
		"target": "ES2020",
		"lib": ["ES2020"],
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"types": [],
		"strict": true,
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"outDir": "./dist",
		"rootDir": "./src"
	},
	"include": ["src/**/*.ts"]
}
